*.sqlite
*.sqlite-*

# Package manager and build logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Test and coverage output
/coverage
/.nyc_output

# Editor and tool directories
/.fleet
/.idea
/.nova
/.vscode
/.zed
.phpactor.json

# OS-generated files
.DS_Store
Thumbs.db
Desktop.ini

# Laragon/Homestead files
Homestead.json
Homestead.yaml

# Keep these files tracked
!/.gitignore
!.env.example
