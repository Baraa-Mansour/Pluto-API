# Dependencies
/vendor/
/node_modules/

# Environment and secrets
.env
.env.backup
.env.production
.env.*.local
/auth.json
/storage/*.key
/storage/pail
/storage/app/firebase_credentials.json

# Laravel generated files
/public/build
/public/hot
/public/storage
/bootstrap/cache/*.php
*.log
/storage/logs/*
/storage/framework/cache/*
/storage/framework/sessions/*
/storage/framework/testing/*
/storage/framework/views/*
